# Midasbot - Environment Configuration
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# ── LLM Provider (pick one) ──────────────────────────────
# Set the provider and model you want to use
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Provider API keys (only need the one you're using)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ── Chat Channels (optional) ─────────────────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Discord bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# ── Web Search (optional) ────────────────────────────────
# Brave Search API key (leave empty to use free DuckDuckGo)
WEB_SEARCH_API_KEY=

# ── Gateway Port (optional) ──────────────────────────────
GATEWAY_PORT=18791
